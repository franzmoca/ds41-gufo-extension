+  /* A prepare whose routes all hit runs no phase. A job for the next layer
+   * keeps running: its parity half is not one this layer's kernels read.
+   * Any other job (this layer's, whose experts were not routed, or one
+   * overtaken) stops taking tasks without waiting for those in flight; the
+   * last of them to land retires it, unless a Resolve or a submission is
+   * already waiting to (both drain in-flight tasks before reusing rows).
+   * Waiting here instead put up to a whole expert read and a phase handshake
+   * on every hit layer while decode predicted every layer (E89). */
+  void Retire(uint32_t layer) {
+    std::lock_guard lock(mutex_);
+    if (!pf_run_ || pf_stop_ || resolving_)
+      return;
+    if (pf_->layer == layer + 1 && !pf_->failed.load())
+      return;
+    pf_stop_ = true;
+    if (pf_inflight_ == 0)
+      FinishRetire();
+    else
+      retiring_ = true;
+  }
+
   /* Time the last phase blocked on its reads after the overlapped work. */
